{
  "name": "feedbackflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered client feedback consolidation and revision tracking for AZINHACK 2026",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "predev": "node scripts/setup-env.mjs",
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "start:server": "npm run start -w server",
    "start:client": "npm run start -w client",
    "smoke:test": "node scripts/smoke-test.mjs",
    "test:demo": "npm run test:demo -w server",
    "test:prototype": "node scripts/prototype-flow-test.mjs",
    "test:tinyfish": "npm run test:tinyfish -w server",
    "check:db": "npm run check:db -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.11.0 <25.0.0"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6"
  },
  "allowScripts": {
    "esbuild": "^0.28.2",
    "@tailwindcss/oxide": "^4.3.3"
  }
}
