# Copy to server/.env for local development. Never commit server/.env.
NODE_ENV=development
PORT=5000
# Use the MongoDB Atlas URI from Connect -> Drivers, or a local MongoDB URI.
# Replace Atlas URI placeholders in server/.env only; never commit secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/feedbackflow
CLIENT_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Enables TinyFish Search (source discovery) and Fetch (page extraction).
TINYFISH_API_KEY=
DUPLICATE_SIMILARITY_THRESHOLD=0.76
ENABLE_DEMO_SEED=true
