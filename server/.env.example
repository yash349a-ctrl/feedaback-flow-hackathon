# Copy to server/.env for local development. Never commit server/.env.
NODE_ENV=development
PORT=5000
# Required for database-backed features. Paste the Atlas Drivers URI into server/.env only.
# Example: mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/feedbackflow?retryWrites=true&w=majority
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Enables TinyFish Search (source discovery) and Fetch (page extraction).
TINYFISH_API_KEY=
DUPLICATE_SIMILARITY_THRESHOLD=0.76
ENABLE_DEMO_SEED=true
# MongoDB is the normal prototype storage. Set true only for an offline, non-persistent rehearsal.
ENABLE_LOCAL_DEMO_MODE=false
